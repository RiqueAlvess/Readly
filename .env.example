# Supabase (cloud-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin
NEXT_PUBLIC_ADMIN_EMAILS=admin@readly.app

# Local Postgres (used by docker-compose db + migration script)
DATABASE_URL=postgres://postgres:postgres@db:5432/readly

# Payment (Kiwify placeholder)
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=https://kiwify.com.br/your-checkout

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
